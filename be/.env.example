# ===== 模型配置（OpenAI 兼容接口）=====
# 单用户模式下去掉了登录，模型 API Key 只需要配置在这里
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TEMPERATURE=0.6
# Kimi/Qwen 等需要关闭思考时设为 true；默认不发送该参数
MODEL_DISABLE_THINKING=false

# LangGraph：单轮最大推理步数（防止工具调用死循环、烧 token）
AGENT_MAX_STEPS=8

# 搜索工具（可选；留空则不注册搜索工具，图仍然可用）
TAVILY_API_KEY=

# ===== MongoDB（LangGraph checkpoint 存储，必需）=====
MONGODB_URI=mongodb://127.0.0.1:27017/chat_robot
# checkpoint 使用的库名，默认取 MONGODB_URI 里的库名
DB_NAME=chat_robot

# MongoDB 认证（本地无认证时留空）
authSource=
user=
pass=

# 应用端口
PORT=3000
